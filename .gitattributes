# Keep line endings as LF in the repo AND in the working folder, on every OS.
# Stops the "LF will be replaced by CRLF" warning on Windows.
* text=auto eol=lf

# Images are binary: never touch them.
*.png binary
*.jpg binary
*.webp binary
*.gif binary

# Left out of release downloads ("Source code" zip on a GitHub release).
# They stay in the repo; users only need the CSS, README and LICENSE.
CLAUDE.md       export-ignore
TODO.md         export-ignore
assets/         export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
